{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swerve Build",
  "version": "0.3.19",
  "identifier": "com.swervebuild.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Swerve Build",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.swervebuild/attachments/**", "$HOME/.swervegrok/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop shell for Grok Build and ACP agents",
    "longDescription": "Swerve Build is a clean Windows desktop app for Grok Build CLI — projects, chats, memories, skills, and multi-provider ACP agents in one native shell.",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}