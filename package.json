{
  "name": "swerve-build",
  "version": "0.3.35",
  "description": "Swerve Build — a clean Windows desktop shell for Grok Build and ACP agents",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test-e2e.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-release.ps1",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-local.ps1",
    "smoke:session": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/session-smoke.ps1",
    "version:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1 -CheckOnly",
    "version:bump": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1",
    "version:set": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bump-version.ps1 -Set",
    "tauri": "tauri"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Swervebytes/SwerveBuild"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/svelte": "^1.6.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
